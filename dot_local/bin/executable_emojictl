#!/usr/bin/env sh

usage() {
    cat <<EOF
Usage: ${0##*/} PROMPT [FILE]...
A wrapper around rofimoji to set a custom prompt and use wl-copy for clipboard.

Options:
  PROMPT          The prompt string to display in rofimoji.
  FILE            One or more emoji data files (e.g., emoji, nerd_font)
                  as accepted by rofimoji's --files option.  If multiple files are
                  given, they are passed as separate arguments after --files.
                  If no FILE is given, rofimoji uses its built-in default data.
  -h, --help      Show this help message.
EOF
}

if [ "$1" = "--help" ] || [ "$1" = "-h" ] || [ $# -eq 0 ]; then
    usage
    exit 0
fi

for cmd in rofimoji wl-copy; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        echo "Error: $cmd not found in PATH" >&2
        exit 1
    fi
done

PROMPT="$1"
shift

if [ $# -gt 0 ]; then
    set -- rofimoji --prompt "$PROMPT" --action clipboard --clipboarder wl-copy --files "$@"
else
    set -- rofimoji --prompt "$PROMPT" --action clipboard --clipboarder wl-copy
fi

exec "$@"
