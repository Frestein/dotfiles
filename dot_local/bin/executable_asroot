#!/usr/bin/env bash

run_with_privileges() {
    if [ -n "$XDG_RUNTIME_DIR" ]; then
        set -- "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR" "$@"
    fi
    if [ -n "$WAYLAND_DISPLAY" ]; then
        set -- "WAYLAND_DISPLAY=$WAYLAND_DISPLAY" "$@"
    fi
    if [ -n "$XDG_SESSION_TYPE" ]; then
        set -- "XDG_SESSION_TYPE=$XDG_SESSION_TYPE" "$@"
    fi
    if [ -n "$LANG" ]; then
        set -- "LANG=$LANG" "$@"
    fi

    if command -v doas >/dev/null 2>&1 && command -v doas_askpass >/dev/null 2>&1; then
        doas_askpass env "$@"
    elif command -v sudo-rs >/dev/null 2>&1; then
        sudo-rs -A env "$@"
    elif command -v sudo >/dev/null 2>&1; then
        sudo -A env "$@"
    elif command -v run0 >/dev/null 2>&1; then
        run0 env "$@"
    else
        return 1
    fi
}

run_with_privileges "$@"
