#!/usr/bin/env sh

# Combined sink switcher using pactl (works with PulseAudio and PipeWire-pulse)
# Cycles through sinks or selects via fuzzel.

usage() {
    cat <<EOF
Usage: ${0##*/} [OPTION]
Switch default audio sink.

Options:
  --dmenu, -d    Interactive selection using fuzzel
  --help, -h      Show this help message

Without options, cycles to next available sink.
EOF
}

# Check for help flag first
case "$1" in
--help | -h)
    usage
    exit 0
    ;;
esac

# Check dependencies
for cmd in pactl notify-send; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        echo "Error: $cmd not found" >&2
        exit 1
    fi
done

# ----------------------------------------------------------------------
# Helper functions working with sink names and descriptions
# ----------------------------------------------------------------------

# Get list of sink names (raw internal names)
get_all_sink_names() {
    pactl list short sinks | cut -f2
}

# Get current default sink name
get_default_sink_name() {
    pactl info | grep 'Default Sink' | cut -d':' -f2 | sed 's/^[[:space:]]*//'
}

# Get description for a given sink name
# Uses pactl list sinks and extracts the Description: field.
get_sink_description() {
    sink_name="$1"
    # Escape dots and other regex characters in sink_name for grep -F (fixed string)
    # Use -F to treat as literal string
    pactl list sinks | grep -A 20 "Name: $sink_name" | grep -m1 "Description:" | cut -d':' -f2- | sed 's/^[[:space:]]*//'
}

# Get all sinks as "name|description" lines
get_all_sinks_with_desc() {
    for name in $(get_all_sink_names); do
        desc=$(get_sink_description "$name")
        # If description is empty, fallback to name
        if [ -z "$desc" ]; then
            desc="$name"
        fi
        echo "$name|$desc"
    done
}

# Notify using description
notify() {
    sink_name="$1"
    desc=$(get_sink_description "$sink_name")
    if [ -z "$desc" ]; then
        desc="$sink_name"
    fi
    notify-send --expire-time 1350 "Switched default output sink to: $desc"
}

# ----------------------------------------------------------------------
# Main logic
# ----------------------------------------------------------------------

if [ "$1" = "--dmenu" ] || [ "$1" = "-d" ]; then
    # Interactive selection with fuzzel
    if ! command -v fuzzel >/dev/null 2>&1; then
        echo "Error: fuzzel not found, cannot select interactively" >&2
        exit 1
    fi

    # Get list of "description (name)" for display
    # We'll build a list where each line is "description (name)"
    # This helps if descriptions are not unique, but name is unique.
    temp_file=$(mktemp)
    get_all_sinks_with_desc | while IFS='|' read -r name desc; do
        echo "$desc ($name)" >>"$temp_file"
    done

    # Show fuzzel and capture chosen line
    chosen=$(cat "$temp_file" | fuzzel -d -p 'Switch Output ' --placeholder 'Choose...' -w 58 --minimal-lines)

    rm -f "$temp_file"

    if [ -n "$chosen" ]; then
        # Extract sink name from the chosen line: everything after last '(' and before ')'
        sink_name=$(echo "$chosen" | sed 's/.*(\(.*\))/\1/')
        if [ -n "$sink_name" ]; then
            pactl set-default-sink "$sink_name"
            notify "$sink_name"
        else
            echo "Error: could not extract sink name from selection" >&2
            exit 1
        fi
    else
        exit 1
    fi
else
    # Check for unexpected arguments
    if [ $# -gt 0 ]; then
        echo "Error: Unknown option: $1" >&2
        usage >&2
        exit 1
    fi

    # Circular cycle through sinks using names
    default_sink=$(get_default_sink_name)
    sinks=$(get_all_sink_names)
    first=""
    next_sink=""
    found=0

    for sink in $sinks; do
        [ -z "$first" ] && first=$sink
        if [ $found -eq 1 ]; then
            next_sink=$sink
            break
        fi
        [ "$sink" = "$default_sink" ] && found=1
    done

    # Wrap around if no next sink found
    [ -z "$next_sink" ] && next_sink=$first

    pactl set-default-sink "$next_sink"
    notify "$next_sink"
fi
