# Generated from docs/externals.org - do not edit directly.

{{- $yazi_plugins_base := "https://github.com/yazi-rs/plugins/archive/master.tar.gz" }}
{{- $yazi_plugins_list := list
    "types.yazi"
    "chmod.yazi"
    "diff.yazi"
    "toggle-pane.yazi"
    "zoom.yazi"
    "git.yazi"
    "vcs-files.yazi"
    "mount.yazi"
    "full-border.yazi"
    "smart-enter.yazi"
    "smart-filter.yazi"
}}

{{- range $plugin := $yazi_plugins_list }}
[".config/yazi/plugins/{{ $plugin }}"]
type = "archive"
url = {{ $yazi_plugins_base | quote }}
exact = true
stripComponents = 2
refreshPeriod = "336h"
include = ["*/{{ $plugin }}/**"]
{{- end }}

