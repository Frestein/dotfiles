{{- if (env "CZ_EXT") }}

# Plugins
## Personal plugins
### confirm-quit.yazi - Confirm quit
### folder-rules.yazi - Custom per-folder rules
### parent-arrow.yazi - QoL. Change parent directory
### smart-tab.yazi - Create tab for focused directory

## Official plugins
### types.yazi - Type definitions for language server
### chmod.yazi - Change the file mode bits
### diff.yazi - Diff for selected and hovered file
### toggle-pane.yazi - Maximize preview pane
### zoom.yazi - Zoom image on preview pane
### git.yazi - Git status
### vcs-files.yazi - Filter files by Git changes
### mount.yazi - Mount manager for disks
### full-border.yazi - UI. Full border
### smart-enter.yazi - QoL. Open files or enter directories all in one key
### smart-filter.yazi - Continuous filtering, automatically enter unique directory, open file on submitting

{{- $yazi_plugins_base := "https://github.com/yazi-rs/plugins/archive/master.tar.gz" }}
{{- $yazi_plugins_list := list
    "types.yazi"
    "chmod.yazi"
    "diff.yazi"
    "toggle-pane.yazi"
    "zoom.yazi"
    "git.yazi"
    "vcs-files.yazi"
    "mount.yazi"
    "full-border.yazi"
    "smart-enter.yazi"
    "smart-filter.yazi"
}}

{{- range $plugin := $yazi_plugins_list }}
[".config/yazi/plugins/{{ $plugin }}"]
type = "archive"
url = {{ $yazi_plugins_base | quote }}
exact = true
stripComponents = 2
refreshPeriod = "336h"
include = ["*/{{ $plugin }}/**"]
{{- end }}

