{{- $uosc_url := gitHubReleaseAssetURL "tomasklaen/uosc" .versions.tomasklaen_uosc "uosc.zip" }}

[".config/mpv/fonts"]
type = "archive"
url = {{ $uosc_url | quote }}
exact = true
stripComponents = 1
include = ["fonts/**"]

[".config/mpv/scripts/uosc"]
type = "archive"
url = {{ $uosc_url | quote }}
exact = true
stripComponents = 2
include = ["scripts/**"]

[".config/mpv/scripts/M-x.lua"]
type = "file"
url = "https://raw.githubusercontent.com/Seme4eg/mpv-scripts/refs/heads/master/M-x.lua"
refreshPeriod = "336h"

[".config/mpv/script-modules/extended-menu.lua"]
type = "file"
url = "https://raw.githubusercontent.com/Seme4eg/mpv-scripts/refs/heads/master/script-modules/extended-menu.lua"
refreshPeriod = "336h"

[".config/mpv/scripts/thumbfast.lua"]
type = "file"
url = "https://raw.githubusercontent.com/po5/thumbfast/refs/heads/master/thumbfast.lua"
refreshPeriod = "336h"

{{- $gallery_repo := "https://raw.githubusercontent.com/occivink/mpv-gallery-view/master" }}

