#!/usr/bin/env bash
# Highlight packages of interest in arch-update's column-formatted lists.
# Used only through the arch-update wrapper; see highlight.conf for patterns.

set -o pipefail

real_column=${ARCH_UPDATE_REAL_COLUMN:-/usr/bin/column}
config_file=${ARCH_UPDATE_HIGHLIGHT_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/arch-update/highlight.conf}

if [[ ${ARCH_UPDATE_HIGHLIGHT:-} == 0 ]] || [[ ! -r $config_file ]]; then
    exec "$real_column" "$@"
fi

awk -v config="$config_file" '
BEGIN {
    esc = sprintf("%c", 27)
    section = ""

    while ((getline entry < config) > 0) {
        sub(/[[:space:]]*#.*/, "", entry)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", entry)

        if (entry == "") {
            continue
        }
        if (entry ~ /^\[.*\]$/) {
            section = substr(entry, 2, length(entry) - 2)
            continue
        }
        if (section == "exact") {
            exact[++exact_count] = entry
        } else if (section == "any") {
            any[++any_count] = entry
        }
    }
    close(config)
}

{
    # Package lines from arch-update carry the old -> new version arrow.
    if (index($0, " -> ") == 0) {
        print
        next
    }

    plain = $0
    gsub(esc "\\[[0-9;]*m", "", plain)
    sub(/^[[:space:]]+/, "", plain)

    name = plain
    sub(/[[:space:]].*$/, "", name)

    highlight = 0
    for (i = 1; i <= exact_count; i++) {
        if (name == exact[i]) {
            highlight = 1
            break
        }
    }
    if (!highlight) {
        for (i = 1; i <= any_count; i++) {
            if (index(plain, any[i]) > 0) {
                highlight = 1
                break
            }
        }
    }

    if (highlight) {
        print esc "[33m" $0 esc "[0m"
    } else {
        print
    }
}' | "$real_column" "$@"
