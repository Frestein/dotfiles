[Desktop Entry]
Name=Emacsclient (Telega)
GenericName=Telega URL Handler
Comment=Handle tg and tonsite links with Telega in Emacs (client)
MimeType=x-scheme-handler/tg;x-scheme-handler/tonsite;
Exec=/usr/bin/emacsclient --alternate-editor="" --reuse-frame --eval "(telega-browse-url \"%u\")"
Icon=emacs
Type=Application
Terminal=false
NoDisplay=true
Categories=Network;InstantMessaging;
StartupNotify=true
StartupWMClass=Emacs
Keywords=emacsclient;
Actions=new-window;new-instance;

[Desktop Action new-window]
Name=New Window
Exec=/usr/bin/emacsclient --alternate-editor="" --create-frame --eval "(telega-browse-url \"%u\")"

[Desktop Action new-instance]
Name=New Instance
Exec=emacs --eval "(browse-url \"%u\")"
