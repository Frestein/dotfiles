#!/usr/bin/env bash
# List pending updates and highlight packages of interest.
# Requires: arch-update and awk.
# Config: $XDG_CONFIG_HOME/arch-update/highlight.conf

set -o pipefail

config_dir=${XDG_CONFIG_HOME:-$HOME/.config}
config_file=${ARCH_UPDATE_HIGHLIGHT_CONFIG:-$config_dir/arch-update/highlight.conf}

if [[ ! -r $config_file ]]; then
    printf 'arch-update-highlight: cannot read config: %s\n' "$config_file" >&2
    exec arch-update -l "$@"
fi

arch-update -l "$@" | awk -v config="$config_file" '
BEGIN {
    esc = sprintf("%c", 27)
    section = ""

    while ((getline entry < config) > 0) {
        sub(/[[:space:]]*#.*/, "", entry)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", entry)

        if (entry == "") {
            continue
        }
        if (entry ~ /^\[.*\]$/) {
            section = substr(entry, 2, length(entry) - 2)
            continue
        }
        if (section == "exact") {
            exact[++exact_count] = entry
        } else if (section == "any") {
            any[++any_count] = entry
        }
    }
    close(config)
}

{
    plain = $0
    gsub(esc "\\[[0-9;]*m", "", plain)
    sub(/^[[:space:]]+/, "", plain)

    name = plain
    sub(/[[:space:]].*$/, "", name)

    highlight = 0
    for (i = 1; i <= exact_count; i++) {
        if (name == exact[i]) {
            highlight = 1
            break
        }
    }
    if (!highlight) {
        for (i = 1; i <= any_count; i++) {
            if (index(plain, any[i]) > 0) {
                highlight = 1
                break
            }
        }
    }

    if (highlight) {
        print esc "[33m" $0 esc "[0m"
    } else {
        print
    }
}'
