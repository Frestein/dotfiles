#!/usr/bin/env sh

usage() {
	cat <<EOF
Usage: ${0##*/} [OPTION] [--confirm]

Options:
  --dmenu              Show interactive menu (default if no options)
  --logout             Log out from the session
  --lock               Lock the screen
  --reboot             Reboot the system
  --shutdown           Power off the system
  --confirm            Ask for confirmation before performing action
  --help, -h           Show this help
EOF
}

# Error handling
error() {
	msg="$1"
	if [ -t 2 ]; then
		echo "Error: $msg" >&2
	else
		notify-send -h string:x-dunst-stack-tag:session -u critical "Session" "Error: $msg" 2>/dev/null || echo "Error: $msg" >&2
	fi
	exit 1
}

# Confirmation dialog via fuzzel
confirm_action() {
	action_name="$1"
	choice=$(printf "Yes\nNo" | fuzzel -d --minimal-lines -p "Confirm ${action_name}? " --placeholder "Choose...")
	[ "$choice" = "Yes" ]
}

do_logout() {
	if uwsm check is-active; then
		uwsm stop
	elif [ -n "${HYPRLAND_INSTANCE_SIGNATURE}" ]; then
		if command -v hyprshutdown >/dev/null 2>&1; then
			hyprshutdown
		else
			hyprctl dispatch "hl.dsp.exit()"
		fi
	fi
}

do_lock() {
	loginctl lock-session
}

do_reboot() {
	systemctl reboot
}

do_shutdown() {
	systemctl poweroff
}

# Show menu and return selected action name (e.g. "logout")
show_menu() {
	options="󰗽 Logout\n Lock\n Reboot\n Shutdown"

	selected=$(printf "%b" "$options" | fuzzel -d \
		--minimal-lines \
		-p "󰣇 " \
		--placeholder "Session ")

	# Extract action name from selected line (first word after icon)
	echo "$selected" | awk '{print tolower($2)}'
}

main() {
	local action=""
	local confirm=0

	# Parse arguments
	for arg in "$@"; do
		case "$arg" in
		--confirm) confirm=1 ;;
		--logout | --lock | --reboot | --shutdown | --dmenu)
			action="$arg"
			;;
		--help | -h)
			usage
			exit 0
			;;
		*)
			error "Unknown option '$arg'"
			;;
		esac
	done

	# Default to --dmenu if no action given
	if [ -z "$action" ]; then
		action="--dmenu"
	fi

	# If --dmenu, get action from menu
	if [ "$action" = "--dmenu" ]; then
		selected_action=$(show_menu)
		if [ -z "$selected_action" ]; then
			exit 0 # canceled
		fi
		# Map selected action to command
		case "$selected_action" in
		logout) action="--logout" ;;
		lock) action="--lock" ;;
		reboot) action="--reboot" ;;
		shutdown) action="--shutdown" ;;
		*) exit 0 ;;
		esac
	fi

	# Confirm if requested
	if [ $confirm -eq 1 ]; then
		action_name="${action#--}"
		if ! confirm_action "$action_name"; then
			exit 0
		fi
	fi

	# Execute action
	case "$action" in
	--logout) do_logout ;;
	--lock) do_lock ;;
	--reboot) do_reboot ;;
	--shutdown) do_shutdown ;;
	*) error "Internal error: unknown action '$action'" ;;
	esac
}

main "$@"
