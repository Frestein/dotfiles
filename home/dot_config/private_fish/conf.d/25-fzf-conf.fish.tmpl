status is-interactive; or exit

type -q fzf; or exit

function fzf_bind_multiply
    set multiplier $argv[1]
    set prefix $argv[2]
    set prefixes (for i in (seq $multiplier); echo $prefix; end)
    echo (string join + $prefixes)
end

set preview_down (fzf_bind_multiply 10 'preview-down')
set preview_up (fzf_bind_multiply 10 'preview-up')

set -gx FZF_CTRL_T_OPTS "
    --bind 'alt-p:toggle-preview'
    --list-border='sharp'
    --border-label='Files'
    --border-label-pos=-4
    --header 'Preview <M-p>'
    --color header:italic
    --preview 'fzf-preview.sh {}'
"
set -gx FZF_CTRL_R_OPTS "
    --bind 'alt-y:execute-silent(echo -n {2..} | fish_clipboard_copy)+abort'
    --list-border='sharp'
    --border-label='Command History'
    --border-label-pos=-4
    --header 'Copy <M-y>'
    --color header:italic
    --layout=reverse
"
set -gx FZF_ALT_C_OPTS "
    --bind 'alt-p:toggle-preview'
    --bind 'alt-m:change-multi'
    --list-border='sharp'
    --border-label='Directories'
    --border-label-pos=-4
    --header 'Preview <M-p>  Multi <M-m>'
    --color header:italic
    --walker=dir,follow
    --walker-skip GDrive,node_modules
    --preview 'eza -T --color=always --icons {}'
"

# Respect .gitignore
set -gx FZF_DEFAULT_COMMAND "fd --type f --strip-cwd-prefix"
set -gx FZF_CTRL_T_COMMAND "$FZF_DEFAULT_COMMAND"

set -gx FZF_DEFAULT_OPTS "
    --bind 'ctrl-y:accept'
    --bind 'ctrl-f:$preview_down'
    --bind 'ctrl-b:$preview_up'
    --height 100%
{{- range .fzf.common }}
    {{ . }}
{{- end }}
    --preview-window='border-sharp'
    --color '
{{- range .fzf.colors }}
        {{ . }}
{{- end }}
    '
"

set -e preview_down preview_up fzf_bind_multiply
