[Unit]
Description=Waybar autohide script
PartOf=graphical-session.target waybar.service
After=graphical-session.target waybar.service

[Service]
ExecStart=%h/.config/hypr/scripts/waybar_autohide.sh
ExecStopPost=%h/.config/hypr/scripts/waybar_show.sh
Restart=on-failure

[Install]
WantedBy=graphical-session.target
