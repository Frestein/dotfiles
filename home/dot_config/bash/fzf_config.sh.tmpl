#!/usr/bin/env bash

function fzf_bind_multiply() {
	local multiplier="$1"
	local prefix="$2"
	local result=""

	local i
	for ((i = 1; i <= multiplier; i++)); do
		result+="${prefix}+"
	done

	echo "${result%+}"
}

preview_down=$(fzf_bind_multiply 10 'preview-down')
preview_up=$(fzf_bind_multiply 10 'preview-up')

export FZF_CTRL_T_OPTS="
    --bind 'alt-p:toggle-preview'
    --list-border='sharp'
    --border-label='Files'
    --border-label-pos=-4
    --header 'Preview <M-p>'
    --color header:italic
    --preview 'fzf-preview.sh {}'
"
export FZF_CTRL_R_OPTS="
    --bind 'alt-y:execute-silent(echo -n {2..} | wl-copy)+abort'
    --list-border='sharp'
    --border-label='Command History'
    --border-label-pos=-4
    --header 'Copy <M-y>'
    --color header:italic
    --layout=reverse
"
export FZF_ALT_C_OPTS="
    --bind 'alt-p:toggle-preview'
    --bind 'alt-m:change-multi'
    --list-border='sharp'
    --border-label='Directories'
    --border-label-pos=-4
    --header 'Preview <M-p>  Multi <M-m>'
    --color header:italic
    --walker=dir,follow
    --walker-skip GDrive,node_modules
    --preview 'eza -T --color=always --icons {}'
"

# Respect .gitignore
export FZF_DEFAULT_COMMAND="fd --type f --strip-cwd-prefix"
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"

# Use fd for path completion: respects .gitignore and skips hidden dirs
_fzf_compgen_path() {
    fd --follow . "$1"
}

_fzf_compgen_dir() {
    fd --type d --follow . "$1"
}

export FZF_DEFAULT_OPTS="
    --bind 'ctrl-y:accept'
    --bind 'ctrl-f:$preview_down'
    --bind 'ctrl-b:$preview_up'
    --height 100%
{{- range .fzf.common }}
    {{ . }}
{{- end }}
    --preview-window='border-sharp'
    --color '
{{- range .fzf.colors }}
        {{ . }}
{{- end }}
    '
"

unset preview_down preview_up fzf_bind_multiply
