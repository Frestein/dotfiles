{
  "$schema": "https://opencode.ai/config.json",
  "policies": [
    { "action": "tool.use", "resource": "shell:*chezmoi apply*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*chezmoi status*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*chezmoi diff*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*chezmoi add*--encrypt*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*chezmoi re-add*--re-encrypt*", "effect": "deny" },

    // Close everything outside the Location and the worktree.
    { "action": "tool.use", "resource": "external_directory:*", "effect": "deny" },

    // Allowlist: explicit exceptions go after the broad deny (last match wins).
    // Policy resources use absolute paths: `~` is not expanded there.
    { "action": "tool.use", "resource": "external_directory:/home/frestein/.config/*", "effect": "allow" },
    { "action": "tool.use", "resource": "external_directory:/home/frestein/Projects/*", "effect": "allow" },
    { "action": "tool.use", "resource": "external_directory:/home/frestein/Tools/*", "effect": "allow" },
    { "action": "tool.use", "resource": "external_directory:/home/frestein/.local/bin/*", "effect": "allow" },
    { "action": "tool.use", "resource": "external_directory:/home/frestein/.local/share/opencode/tool-output/*", "effect": "allow" },
    { "action": "tool.use", "resource": "external_directory:/tmp/opencode/*", "effect": "allow" },
    { "action": "tool.use", "resource": "external_directory:/usr/share/*", "effect": "allow" },
    { "action": "tool.use", "resource": "external_directory:/etc/*", "effect": "allow" },

    // Sensitive targets inside allowed directories: deny after the allow rules.
    { "action": "tool.use", "resource": "read:/home/frestein/.config/qutebrowser/quickmarks", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:/home/frestein/.config/qutebrowser/quickmarks", "effect": "deny" },
    { "action": "tool.use", "resource": "read:/home/frestein/.config/qutebrowser/web_exclude.txt", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:/home/frestein/.config/qutebrowser/web_exclude.txt", "effect": "deny" },
    { "action": "tool.use", "resource": "read:/home/frestein/.config/YouTube Music/config.json", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:/home/frestein/.config/YouTube Music/config.json", "effect": "deny" },
    { "action": "tool.use", "resource": "read:/home/frestein/.config/authinfo", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:/home/frestein/.config/authinfo", "effect": "deny" },
    { "action": "tool.use", "resource": "read:/home/frestein/.config/nvchecker/keyfile.toml", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:/home/frestein/.config/nvchecker/keyfile.toml", "effect": "deny" },
    { "action": "tool.use", "resource": "read:/home/frestein/.config/msmtp/config", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:/home/frestein/.config/msmtp/config", "effect": "deny" },
    { "action": "tool.use", "resource": "read:/home/frestein/.config/opencode/service.json", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:/home/frestein/.config/opencode/service.json", "effect": "deny" },
    { "action": "tool.use", "resource": "read:/home/frestein/.config/opencode/cli.json", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:/home/frestein/.config/opencode/cli.json", "effect": "deny" },
    { "action": "tool.use", "resource": "read:/home/frestein/.config/chromium/*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:/home/frestein/.config/chromium/*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:/home/frestein/.config/google-chrome/*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:/home/frestein/.config/google-chrome/*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:/home/frestein/.config/rclone/*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:/home/frestein/.config/rclone/*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:/home/frestein/.config/weechat/*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:/home/frestein/.config/weechat/*", "effect": "deny" },

    // Shell fallback for distinctive sensitive file names.
    { "action": "tool.use", "resource": "shell:*authinfo*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*quickmarks*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*web_exclude*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*keyfile.toml*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*service.json*", "effect": "deny" }
  ]
}
