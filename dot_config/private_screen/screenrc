startup_message off

deflogin on

vbell off

# Correct colors
truecolor on
term screen-256color

# Fix escape delay
maptimeout 10

# You'll like it
altscreen on

# Scrollback
# Enable mouse whell scrolling
termcapinfo xterm*|rxvt*|kterm*|Eterm*|foot* ti@:te@
defscrollback 20000

# Screensaver
blankerprg cmatrix
idle 300 blanker
# or disable blanker
# blankerprg ""
# idle 0

# Keybindings
bind \\ quit
# Reload config
bind R source $XDG_CONFIG_HOME/screen/screenrc
